{
  "name": "ThelaWala - Street Food Delivery",
  "short_name": "ThelaWala",
  "id": "/?source=pwa",
  "description": "Order authentic street food and fast delivery from local thelas across Bhubaneswar.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#ff6600",
  "categories": ["food", "shopping", "lifestyle"],
  "icons": [
